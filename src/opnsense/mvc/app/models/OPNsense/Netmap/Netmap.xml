<model>
    <mount>//OPNsense/netmap</mount>
    <version>1.4.0</version>
    <description>Network map: names, kinds and notes of devices</description>
    <items>
        <general>
            <refresh type="IntegerField">
                <Default>10</Default>
                <MinimumValue>5</MinimumValue>
                <MaximumValue>120</MaximumValue>
                <Required>Y</Required>
                <ValidationMessage>Between 5 and 120 seconds.</ValidationMessage>
            </refresh>
            <new_devices type="BooleanField">
                <Default>1</Default>
                <Required>Y</Required>
            </new_devices>
            <firewall_actions type="BooleanField">
                <Default>1</Default>
                <Required>Y</Required>
            </firewall_actions>
            <scans type="BooleanField">
                <Default>1</Default>
                <Required>Y</Required>
            </scans>
            <hidden_networks type="CSVListField">
                <Mask>/^[a-z0-9_]{0,32}$/</Mask>
            </hidden_networks>
        </general>
        <adguard>
            <enabled type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </enabled>
            <host type="HostnameField">
                <IpAllowed>Y</IpAllowed>
                <Default>127.0.0.1</Default>
                <ValidationMessage>An IP address or host name, for example 127.0.0.1.</ValidationMessage>
            </host>
            <port type="PortField">
                <Default>3000</Default>
                <ValidationMessage>A port number, for example 3000.</ValidationMessage>
            </port>
            <https type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </https>
            <username type="TextField">
                <Mask>/^[^\s]{0,64}$/</Mask>
            </username>
            <password type="TextField">
                <Mask>/^[^\n\r]{0,128}$/</Mask>
            </password>
            <verify_tls type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </verify_tls>
        </adguard>
        <devices>
            <device type="ArrayField">
                <mac type="MacAddressField">
                    <Required>Y</Required>
                </mac>
                <name type="TextField">
                    <Mask>/^[^\n\r]{0,64}$/</Mask>
                    <ValidationMessage>Up to 64 characters.</ValidationMessage>
                </name>
                <kind type="TextField">
                    <Mask>/^[a-z]{0,16}$/</Mask>
                </kind>
                <group type="TextField">
                    <Mask>/^[^\n\r,]{0,32}$/</Mask>
                    <ValidationMessage>Up to 32 characters, no commas.</ValidationMessage>
                </group>
                <approved type="BooleanField">
                    <Default>0</Default>
                    <Required>Y</Required>
                </approved>
                <notes type="TextField">
                    <Mask>/^[^\n\r]{0,256}$/</Mask>
                    <ValidationMessage>Up to 256 characters on one line.</ValidationMessage>
                </notes>
            </device>
        </devices>
    </items>
</model>
